{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:chat": "tsx scripts/serve.ts --dev",
    "build": "tsx scripts/validate-resume.ts && tsx scripts/build-tokens.ts && tsx scripts/copy-vendor.ts && tsx scripts/lint-tokens.ts && next build",
    "serve": "tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "tsx scripts/lint-tokens.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:chat": "tsx scripts/chat-eval.ts",
    "deploy": "npm run build && wrangler pages deploy out --project-name folio",
    "tokens": "tsx scripts/build-tokens.ts",
    "validate": "tsx scripts/validate-resume.ts",
    "cf:dev": "wrangler pages dev out",
    "check": "npm run build && npm run typecheck && npm test"
  },
